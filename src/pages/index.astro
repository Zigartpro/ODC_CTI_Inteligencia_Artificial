---
import CourseShell from '../components/CourseShell';
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Automatización de flujos con IA (n8n) para pymes (ODC)</title>
		<script is:inline>
			(function () {
				try {
					var guardado = localStorage.getItem('odc-tema');
					var oscuro = guardado ? guardado === 'oscuro' : window.matchMedia('(prefers-color-scheme: dark)').matches;
					if (oscuro) document.documentElement.classList.add('dark');
				} catch (e) {}
			})();
		</script>
	</head>
	<body class="bg-white dark:bg-slate-900">
		<CourseShell client:load />
	</body>
</html>
